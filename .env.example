# Paths
# Folder to scan recursively for incoming media
SOURCE_ROOT=/mnt/nas_photos/incoming

# Folder where the sorted tree will be created
TARGET_ROOT=/mnt/nas_photos/sorted

# Folder where reports/logs will be written (can be inside TARGET_ROOT)
OUTPUT_ROOT=/mnt/nas_photos/sorted/reports

# Optional folders (defaults shown)
QUARANTINE_ROOT=/mnt/nas_photos/_quarantine
REVIEW_ROOT=/mnt/nas_photos/_A_REVOIR

# Execution defaults
# copy: safer first run (duplicates data)
# move: faster if same filesystem/share (rename)
MOVE_MODE=copy

# Safety
DRY_RUN_DEFAULT=true

# Home location (strongly recommended)
# Photos within HOME_RADIUS_KM are always "Vie de famille" (routine).
# Photos beyond that radius use AWAY_EVENT_MIN_ITEMS as the event threshold.
# Find your coordinates: Google Maps → right-click on your home → copy lat/lon
# HOME_LAT=48.8566
# HOME_LON=2.3522
HOME_RADIUS_KM=50
AWAY_EVENT_MIN_ITEMS=10
