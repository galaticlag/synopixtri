#!/bin/sh
. "$(dirname "$0")/common"

# On a fresh install the wizard values arrive as environment variables; on an upgrade the
# existing configuration in the package "var" folder is kept.
if [ -n "${wizard_photos}" ]; then
    esc() { printf '%s' "$1" | sed "s/'/'\\''/g"; }
    {
        echo "PHOTOS='$(esc "${wizard_photos}")'"
        echo "PASSWORD='$(esc "${wizard_password}")'"
        echo "OWNER='$(esc "${wizard_owner}")'"
        echo "PORT='$(esc "${wizard_port:-8080}")'"
    } > "$CONF"
    chmod 600 "$CONF"
fi

"$DOCKER" load -i "${SYNOPKG_PKGDEST}/image.tar.gz" > /dev/null 2>&1 || exit 1
exit 0
