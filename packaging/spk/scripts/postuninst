#!/bin/sh
. "$(dirname "$0")/common"
# Keep the database and settings on upgrade; on a real uninstall only the image goes (the data
# folder stays in the package var folder until DSM removes it, photos are never touched).
[ "${SYNOPKG_PKG_STATUS}" = "UPGRADE" ] || "$DOCKER" rmi "$IMAGE" > /dev/null 2>&1
exit 0
